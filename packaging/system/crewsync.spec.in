Name: crewsync
Version: @VERSION@
Release: 1%{?dist}
Summary: CrewSync file synchronizer
License: GPL-3.0-only
URL: https://github.com/goncalvesl/crewsync
BuildArch: @RPM_ARCH@
Requires(pre): shadow-utils
Requires: systemd
Requires: util-linux
Requires: openssl
%description
Rust file synchronizer with a Linux system service and clients.
%pre
getent group crewsync >/dev/null || groupadd -r crewsync
getent passwd crewsync >/dev/null || useradd -r -g crewsync -d /var/lib/crewsync -s /sbin/nologin -M crewsync
exit 0
%post
chown crewsync:crewsync /var/lib/crewsync
chmod 0700 /var/lib/crewsync
systemctl daemon-reload >/dev/null 2>&1 || :
systemctl try-restart crewsync-server.service >/dev/null 2>&1 || :
%preun
if [ "$1" -eq 0 ]; then systemctl disable --now crewsync-server.service >/dev/null 2>&1 || :; fi
%postun
systemctl daemon-reload >/dev/null 2>&1 || :
