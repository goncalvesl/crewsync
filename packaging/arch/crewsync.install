post_install() {
  getent group crewsync >/dev/null || groupadd -r crewsync
  getent passwd crewsync >/dev/null || useradd -r -U -d /var/lib/crewsync -s /usr/bin/nologin -M crewsync
  install -d -o crewsync -g crewsync -m 0750 /var/lib/crewsync
  systemctl daemon-reload || true
}

post_upgrade() {
  post_install
  systemctl try-restart crewsync-server.service >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now crewsync-server.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload || true
}
