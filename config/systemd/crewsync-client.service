# Uma unidade por compartilhamento; adaptar o nome Obras e os caminhos absolutos.
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=3
Description=CrewSync periodic reconciliation for Obras
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/crewsync-client watch %h/.config/crewsync/session.json Obras %h/CrewSync-Obras 5
Restart=on-failure
RestartSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
