# Uma raiz local para todos os compartilhamentos autorizados.
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=3
Description=CrewSync reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/crewsync-client watch-root %h/.config/crewsync-client/session.json %h/CrewSync 5
Restart=on-failure
RestartSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
