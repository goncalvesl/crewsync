# Exemplo: adaptar caminhos absolutos e instalar como unidade de usuário.
# Próxima versão: para proxy no mesmo host, substitua ExecStart por:
# ExecStart=%h/.local/bin/crewsync-server serve-http %h/crewsync-pilot/server.toml 127.0.0.1 8080
# HTTPS termina no proxy; mantenha o backend privado.
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=3
Description=CrewSync HTTPS pilot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/crewsync-server serve %h/crewsync-pilot/server.toml 0.0.0.0 8443 %h/crewsync-pilot/tls/server.crt %h/crewsync-pilot/tls/server.key
Restart=on-failure
RestartSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
